# URL pública del sitio (usada para canonical, hreflang y Open Graph)
NUXT_PUBLIC_SITE_URL=https://cursos.geeksium.com

# Google Analytics 4. Si se deja vacío, la analítica simplemente no se carga
# y el sitio funciona con normalidad.
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Enlaces completos de PayPal para invitar uno o dos chocolates. Si ambos están
# vacíos, el botón de apoyo económico se oculta.
NUXT_PUBLIC_PAYPAL_CHOCOLATE_1_URL=
NUXT_PUBLIC_PAYPAL_CHOCOLATE_2_URL=

# FUTURE — se añadirán cuando exista autenticación (no usado en Fase 1)
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
