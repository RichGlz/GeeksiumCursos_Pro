# URL pública del sitio (usada para canonical, hreflang y Open Graph)
NUXT_PUBLIC_SITE_URL=https://cursos.geeksium.com

# Google Analytics 4. Si se deja vacío, la analítica simplemente no se carga
# y el sitio funciona con normalidad.
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe Payment Links públicos para invitar uno o dos chocolates.
# NUXT_PUBLIC_STRIPE_CHOCOLATE_1_URL configura la primera opción y
# NUXT_PUBLIC_STRIPE_CHOCOLATE_2_URL la segunda. Solo se muestran opciones con
# URL HTTPS válida; si ambas quedan vacías, el botón se oculta por completo.
NUXT_PUBLIC_STRIPE_CHOCOLATE_1_URL=https://buy.stripe.com/test_4gM14nbix2Mo5sefOO1gs00
NUXT_PUBLIC_STRIPE_CHOCOLATE_2_URL=https://buy.stripe.com/test_5kQ7sLgCR4Uw6wi1XY1gs01

# FUTURE — se añadirán cuando exista autenticación (no usado en Fase 1)
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
